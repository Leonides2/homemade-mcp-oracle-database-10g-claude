# Copia este archivo a ".env" y llena los valores reales.
# NUNCA subas el archivo ".env" (con datos reales) a un repositorio.

# --- Conexion a Oracle ---
ORACLE_HOST=
ORACLE_PORT=1521
# Usa ORACLE_SERVICE_NAME o ORACLE_SID (uno de los dos, segun como este configurado el 10g)
ORACLE_SERVICE_NAME=
ORACLE_SID=

ORACLE_USER=
ORACLE_PASSWORD=

# --- Oracle Instant Client (modo thick, requerido para hablar con Oracle 10g) ---
# Ruta a la carpeta del Instant Client ya instalado (ej: C:\oracle\instantclient_11_2)
ORACLE_INSTANT_CLIENT_DIR=

# --- Politica de la utilidad ---
# true = solo se permiten sentencias SELECT (recomendado para este proyecto)
READ_ONLY=true
# Maximo de filas que se devuelven por consulta
MAX_ROWS=200
# Timeout de la consulta en segundos
QUERY_TIMEOUT_SECONDS=30
